# SparkTower — server + web
#
# Copy to `.env` and fill in. `npm run dev` loads it via `tsx --env-file`; the
# test suite loads it too but pins its own values for anything that would make
# a run depend on who is running it (see vitest.config.ts).
#
# Nothing in this file is read by the browser directly. The client gets what it
# needs from the API.

# --- Required to boot -------------------------------------------------------

# Postgres. Locally, any database you own; the test suite derives `<name>_test`
# from this and creates it itself. If your server needs credentials, put
# `user:password@` in front of the host, or set PGUSER / PGPASSWORD instead.
DATABASE_URL=postgresql://127.0.0.1:5432/sparktower

# Signs session cookies. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to boot in production on the development fallback.
SESSION_SECRET=

# OpenAI. The route files construct the client at import, so the server does
# not start without this. Tests pin a fake value; they never call the API.
AI_INTEGRATIONS_OPENAI_API_KEY=
# Optional: a proxy or alternative base URL for the OpenAI API.
AI_INTEGRATIONS_OPENAI_BASE_URL=

# --- Who runs the site --------------------------------------------------------

# The one account that can open the behaviour console. Fails closed if unset.
PLATFORM_OWNER_EMAIL=you@example.com
# Comma-separated. Reviewers approve backer payouts and work the report queue.
# Re-derived at every boot; removing an address removes the role.
PLATFORM_REVIEWER_EMAILS=you@example.com

# --- Optional integrations ------------------------------------------------

# Google sign-in (web). Both required for the button to appear.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native Google sign-in on iOS/Android verifies against these too.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Override the OAuth callback host, e.g. for testers on your wifi:
#   AUTH_HOST=10.0.0.56:5001
AUTH_HOST=

# Stripe. Without a secret key, billing routes are skipped at boot.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Public URL Stripe can reach for webhooks. Unset locally.
PUBLIC_URL=

# Printful print-on-demand, for merch. Off by default (surface: backing).
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# GitHub token for the code-audit feature (reads repositories).
GITHUB_TOKEN=

# Object storage. Unset in development and test, which use local disk
# (`local_objects/`). Set in production to a bucket path.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Tuning (all have sensible defaults) ----------------------------------

PORT=5001
# Models. Defaults live in server/aiModels.ts.
AI_DEFAULT_MODEL=
AI_PRIORITY_MODEL=
AI_IMAGE_MODEL=
# Separate signing secret for mobile access tokens; falls back to SESSION_SECRET.
MOBILE_TOKEN_SECRET=

# --- Set by Replit; leave unset elsewhere -----------------------------------
# REPLIT_DOMAINS, REPLIT_DEPLOYMENT, REPL_IDENTITY, REPLIT_CONNECTORS_HOSTNAME
