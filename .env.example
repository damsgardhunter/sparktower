# SparkTower — server + web
#
# Copy to `.env` and fill in. `npm run dev` loads it via `tsx --env-file`; the
# test suite loads it too but pins its own values for anything that would make
# a run depend on who is running it (see vitest.config.ts).
#
# Nothing in this file is read by the browser directly. The client gets what it
# needs from the API.
#
# Blank means unset. No secret below has a default anywhere in the code: leave
# a required one blank and the server refuses to start (server/secrets.ts).
# Never copy a value from this file, a README or a test into a real deploy.

# --- Required to boot -------------------------------------------------------

# Postgres. Locally, any database you own; the test suite derives `<name>_test`
# from this and creates it itself. If your server needs credentials, put
# `user:password@` in front of the host, or set PGUSER / PGPASSWORD instead.
DATABASE_URL=postgresql://127.0.0.1:5432/sparktower

# Signs session cookies, and is the root of the keys that seal stored secrets
# (2FA, connection strings) and sign 2FA challenges. REQUIRED in every
# environment, local included; there is no fallback. In production it must also
# be at least 32 characters and never a published value. Generate one per
# environment, and don't reuse your local one in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out and makes sealed values unreadable.
SESSION_SECRET=

# Signs mobile access tokens. Set it in production (same rules as above, and a
# different value from SESSION_SECRET). Unset, a key is derived from
# SESSION_SECRET: a real key, not a default, but one secret then backs both.
MOBILE_TOKEN_SECRET=

# OpenAI. The route files construct the client at import, so the server does
# not start without this. Tests pin a fake value; they never call the API.
AI_INTEGRATIONS_OPENAI_API_KEY=
# Optional: a proxy or alternative base URL for the OpenAI API.
AI_INTEGRATIONS_OPENAI_BASE_URL=

# --- Who runs the site --------------------------------------------------------

# The one account that can open the behaviour console. Fails closed if unset:
# nobody is the owner. Must be your real address; there is no placeholder owner.
PLATFORM_OWNER_EMAIL=
# Comma-separated. Reviewers approve backer payouts and work the report queue.
# Re-derived at every boot; removing an address removes the role. Owner and
# reviewers must set up 2FA before using those tools (docs/security/two-factor.md).
PLATFORM_REVIEWER_EMAILS=

# Accounts rate limits never refuse (testers), comma-separated. Platform admins
# are exempt already. Their use is still recorded; sign-in attempts stay limited.
RATE_LIMIT_EXEMPT_EMAILS=

# --- Optional integrations ------------------------------------------------

# Google sign-in (web). Both required for the button to appear.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native Google sign-in on iOS/Android verifies against these too.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Override the OAuth callback host, e.g. for testers on your wifi:
#   AUTH_HOST=10.0.0.56:5001
AUTH_HOST=

# Stripe. Without a secret key, billing routes are skipped at boot.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Verifies webhook signatures. Without it (and with no endpoint registered via
# PUBLIC_URL) every webhook is refused, never accepted unverified.
STRIPE_WEBHOOK_SECRET=
# Public URL Stripe can reach for webhooks. Unset locally.
PUBLIC_URL=

# Printful print-on-demand, for merch. Off by default (surface: backing).
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# GitHub token for the code-audit feature (reads repositories).
GITHUB_TOKEN=

# Object storage. Unset in development and test, which use local disk
# (`local_objects/`). Set in production to a bucket path.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Tuning (not secrets; defaults for these are fine) ---------------------

PORT=5001
# Models. Defaults live in server/aiModels.ts.
AI_DEFAULT_MODEL=
AI_PRIORITY_MODEL=
# The coding model for Nova's build packets (Responses API). Falls back to the
# default model when refused. AI_CODE_REASONING: low | medium | high.
AI_CODE_MODEL=
AI_CODE_REASONING=
AI_IMAGE_MODEL=
# Email (invites). Unset, emails aren't sent: they're written to the server log
# and GET /api/dev/outbox, and the invite link is always shown to copy.
RESEND_API_KEY=
EMAIL_FROM=
# Where a 500 goes besides stderr (server/error-reporting.ts). Any endpoint that
# takes a JSON POST: a Slack or Discord incoming webhook, or an alerting URL.
# Unset, errors are still one structured `[error] {...}` line per failure for a
# log drain to pick up. Reports carry the route pattern, status, error and
# account id — never the body, headers, query string or URL.
ERROR_WEBHOOK_URL=
# Stamped on each report so you can tell which deploy broke. CI sets GITHUB_SHA;
# set this where it doesn't.
RELEASE_SHA=

# --- Set by Replit; leave unset elsewhere -----------------------------------
# REPLIT_DOMAINS, REPLIT_DEPLOYMENT, REPL_IDENTITY, REPLIT_CONNECTORS_HOSTNAME
