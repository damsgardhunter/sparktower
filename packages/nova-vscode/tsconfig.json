{
  /*
   * Bundler resolution, because that is literally true: esbuild resolves these
   * imports and emits one CommonJS file for the host. Telling tsc to type-check
   * as Node16 CommonJS would have it refuse the ESM-only core package that the
   * bundler inlines without trouble — a rule about a module graph that doesn't
   * survive to runtime.
   */
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "rootDir": "src",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "vscode"]
  },
  "include": ["src"]
}
