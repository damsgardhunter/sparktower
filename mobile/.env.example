# SparkTower — mobile (Expo)
#
# Copy to `mobile/.env`. Expo inlines `EXPO_PUBLIC_*` variables into the app
# bundle, so nothing here is secret — these are the OAuth *client ids* Google
# hands out for each platform, and they are visible to anyone who unpacks the
# binary. The server verifies the resulting id token against the same ids
# (GOOGLE_IOS_CLIENT_ID / GOOGLE_ANDROID_CLIENT_ID in the root .env).
#
# The API base URL is read from app.json (`expo.extra.apiUrl`), not from here.

EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
